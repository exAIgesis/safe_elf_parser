with "config/safe_elf_parser_config.gpr";
project Safe_Elf_Parser is

   for Library_Name use "Safe_Elf_Parser";
   for Library_Version use
     Project'Library_Name & ".so." & Safe_Elf_Parser_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Safe_Elf_Parser_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";
   for Library_Interface use ("safe_elf_parser");
   for Library_Standalone use "encapsulated";
   for Library_Auto_Init use "false";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("SAFE_ELF_PARSER_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Safe_Elf_Parser_Config.Ada_Compiler_Switches & ("-gnat2022");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Safe_Elf_Parser;
